{
  "manifest_version": 3,
  "name": "Chrome Extension Starter",
  "version": "0.1.0",
  "description": "Starter extension built with TypeScript and esbuild",
  "action": {
    "default_title": "Starter",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
